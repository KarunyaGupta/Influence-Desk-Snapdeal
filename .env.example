# ─── Data Source ──────────────────────────────────────────────────────────────
# "mock" uses in-memory mock services (no backend required).
# "api" uses real HTTP implementations in src/lib/services/api/.
NEXT_PUBLIC_DATA_SOURCE=mock

# ─── Dev Tools ───────────────────────────────────────────────────────────────
# Shows the floating role-switcher pill. Must be "false" in production.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=true

# Simulated network delay for mock services (ms). Ignored in api mode.
NEXT_PUBLIC_MOCK_LATENCY_MS=350

# ─── API Configuration (used when DATA_SOURCE=api) ───────────────────────────
# Base URL for the backend API.
# NEXT_PUBLIC_API_BASE_URL=https://api.influencerhub.snapdeal.com/v1

# ─── Auth Provider ───────────────────────────────────────────────────────────
# Session cookie name (must match backend cookie config).
# NEXT_PUBLIC_SESSION_COOKIE=sih_session

# Auth provider / token issuer (e.g. Cognito, Auth0, custom JWT).
# AUTH_ISSUER_URL=https://auth.snapdeal.com
# AUTH_CLIENT_ID=your-client-id
# AUTH_CLIENT_SECRET=your-client-secret

# ─── OTP / SMS Gateway ──────────────────────────────────────────────────────
# SMS provider for OTP delivery (MSG91, Twilio, etc.)
# SMS_GATEWAY_API_KEY=your-sms-api-key
# SMS_GATEWAY_SENDER_ID=SNPDIL

# Email provider for OTP / transactional emails.
# EMAIL_GATEWAY_API_KEY=your-email-api-key
# EMAIL_FROM_ADDRESS=noreply@influencerhub.snapdeal.com

# ─── KYC Verification ───────────────────────────────────────────────────────
# NSDL/Protean PAN verification API.
# PAN_VERIFICATION_API_URL=https://api.protean-tech.com/pan/verify
# PAN_VERIFICATION_API_KEY=your-pan-api-key

# RBI IFSC lookup (or RazorpayX IFSC API).
# IFSC_LOOKUP_API_URL=https://ifsc.razorpay.com

# ─── File Storage ────────────────────────────────────────────────────────────
# S3 or compatible object storage for uploaded documents.
# S3_BUCKET_NAME=sih-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# ─── Payment / ERP ──────────────────────────────────────────────────────────
# ERP system for payment processing and UTR tracking.
# ERP_API_URL=https://erp.snapdeal.internal/api
# ERP_API_KEY=your-erp-api-key

# ─── Observability (optional) ────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info
